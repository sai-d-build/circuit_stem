### 5. **Event-Driven Audio System**

```dart
// application/services/event_bus.dart
class EventBus {
  final Map<Type, List<Function>> _subscribers = {};
  
  void subscribe<T>(void Function(T) handler) {
    _subscribers.putIfAbsent(T, () => []).add(handler);
  }
  
  void emit<T>(T event) {
    _subscribers[T]?.forEach((handler) => handler(event));
  }
}

// infrastructure/audio/audio_event_handler.dart
class AudioEventHandler {
  final AudioService _audioService;
  
  AudioEventHandler(this._audioService, EventBus eventBus) {
    eventBus.subscribe<ComponentMovedEvent>(_onComponentMoved);
    eventBus.subscribe<ComponentInteractionEvent>(_onComponentInteraction);
    eventBus.subscribe<LevelCompleteEvent>(_onLevelComplete);
  }
  
  void _onComponentMoved(ComponentMovedEvent event) {
    _audioService.playPlacementSound();
  }
  
  void _onComponentInteraction(ComponentInteractionEvent event) {
    if (event.interaction == 'tap') {
      _audioService.playSelectionSound();
    }
  }
}
```

